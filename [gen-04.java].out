.CODE
PUSH Init_main
CALL
HALT

simple_heap_init: RET 0 ; Retorna inmediatamente

simple_malloc: LOADFP    ; Inicialización unidad
LOADSP
STOREFP ; Finaliza inicialización del RA
LOADHL	; hl
DUP	; hl
PUSH 1	; 1
ADD	; hl+1
STORE 4 ; Guarda el resultado (un puntero a la primer celda de la región de memoria)
LOAD 3	; Carga la cantidad de celdas a alojar (parámetro que debe ser positivo)
ADD
STOREHL ; Mueve el heap limit (hl). Expande el heap
STOREFP
RET 1	; Retorna eliminando el parámetro)

Object_debugPrint: LOADFP ; Apila el valor del registro fp
LOADSP
STOREFP
LOAD 3
IPRINT
STOREFP
RET 1

System_read: LOADFP
LOADFP
LOADSP
STOREFP
READ
STORE 3
STOREFP
RET 0

System_printB: LOADFP
LOADSP
STOREFP
LOAD 3 
BPRINT 
STOREFP
RET 1

System_printC: LOADFP
LOADSP
STOREFP
LOAD 3 
CPRINT 
STOREFP
RET 1

System_printI: LOADFP
LOADSP
STOREFP
LOAD 3 
IPRINT 
STOREFP
RET 1

System_printS: LOADFP
LOADSP
STOREFP
LOAD 3 
SPRINT 
STOREFP
RET 1

System_println: LOADFP
LOADSP
STOREFP
PRNLN
STOREFP
RET 0

System_printBln: LOADFP
LOADSP
STOREFP
LOAD 3 
BPRINT 
PRNLN
STOREFP
RET 1

System_printCln: LOADFP
LOADSP
STOREFP
LOAD 3 
CPRINT 
PRNLN
STOREFP
RET 1

System_printIln: LOADFP
LOADSP
STOREFP
LOAD 3 
IPRINT 
PRNLN
STOREFP
RET 1

System_printSln: LOADFP
LOADSP
STOREFP
LOAD 3 
SPRINT 
PRNLN
STOREFP
RET 1

.DATA
VT_A: DW A_setall,A_m1 ; Etiquetas de metodo de A

.CODE
A_setall: LOADFP   ; Apila el valor del registro
LOADSP    ; Apila el valor del registro sp
STOREFP   ; Almacena el tope de la pila en el registro
RMEM 1 ; Reserva memoria para la variable local x
PUSH 0   ; Apila el entero 0
STORE -1 ; Almacena  el valor de la expresion del tope de la pila en la variable local
RMEM 1 ; Reserva memoria para la variable local y
PUSH 1   ; Apila el entero 1
STORE -2 ; Almacena  el valor de la expresion del tope de la pila en la variable local
RMEM 1 ; Reserva memoria para la variable local z
PUSH 0   ; Apila el entero 0
STORE -3 ; Almacena  el valor de la expresion del tope de la pila en la variable local
RMEM 1 ; Reserva memoria para la variable local f
PUSH 69   ; Apila el entero 69
STORE -4 ; Almacena  el valor de la expresion del tope de la pila en la variable local
FMEM 0
FMEM 0
FMEM 0
FMEM 0
STOREFP   ; Almacena el tope de la pila en el registro
RET 0
A_m1: LOADFP   ; Apila el valor del registro
LOADSP    ; Apila el valor del registro sp
STOREFP   ; Almacena el tope de la pila en el registro
PUSH Object_debugPrint   ; Apilo el metodo
CALL                ; Llamo al método en el tope de la pila
PUSH Object_debugPrint   ; Apilo el metodo
CALL                ; Llamo al método en el tope de la pila
PUSH System_printSln   ; Apilo el metodo
CALL                ; Llamo al método en el tope de la pila
FMEM 0
STOREFP   ; Almacena el tope de la pila en el registro
RET 0
A_debugPrint: LOADFP   ; Apila el valor del registro
LOADSP    ; Apila el valor del registro sp
STOREFP   ; Almacena el tope de la pila en el registro
STOREFP   ; Almacena el tope de la pila en el registro
RET 0
.CODE
Constructor_A: 
LOADFP ; Guarda ED
LOADSP ; Guarda SP
STOREFP ; Corre FP al SP
STOREFP ; Usa ED para volver a RA llamador
RET 1

.DATA
