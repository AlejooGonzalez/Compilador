.CODE
PUSH Init_main
CALL
HALT

simple_heap_init: RET 0 ; Retorna inmediatamente

simple_malloc: LOADFP    ; Inicialización unidad
LOADSP
STOREFP ; Finaliza inicialización del RA
LOADHL	; hl
DUP	; hl
PUSH 1	; 1
ADD	; hl+1
STORE 4 ; Guarda el resultado (un puntero a la primer celda de la región de memoria)
LOAD 3	; Carga la cantidad de celdas a alojar (parámetro que debe ser positivo)
ADD
STOREHL ; Mueve el heap limit (hl). Expande el heap
STOREFP
RET 1	; Retorna eliminando el parámetro)

Object_debugPrint: LOADFP ; Apila el valor del registro fp
LOADSP
STOREFP
LOAD 3
IPRINT
STOREFP
RET 1

System_read: LOADFP
LOADFP
LOADSP
STOREFP
READ
STORE 3
STOREFP
RET 0

System_printB: LOADFP
LOADSP
STOREFP
LOAD 3 
BPRINT 
STOREFP
RET 1

System_printC: LOADFP
LOADSP
STOREFP
LOAD 3 
CPRINT 
STOREFP
RET 1

System_printI: LOADFP
LOADSP
STOREFP
LOAD 3 
IPRINT 
STOREFP
RET 1

System_printS: LOADFP
LOADSP
STOREFP
LOAD 3 
SPRINT 
STOREFP
RET 1

System_println: LOADFP
LOADSP
STOREFP
PRNLN
STOREFP
RET 0

System_printBln: LOADFP
LOADSP
STOREFP
LOAD 3 
BPRINT 
PRNLN
STOREFP
RET 1

System_printCln: LOADFP
LOADSP
STOREFP
LOAD 3 
CPRINT 
PRNLN
STOREFP
RET 1

System_printIln: LOADFP
LOADSP
STOREFP
LOAD 3 
IPRINT 
PRNLN
STOREFP
RET 1

System_printSln: LOADFP
LOADSP
STOREFP
LOAD 3 
SPRINT 
PRNLN
STOREFP
RET 1

.DATA
VT_A: DW A_mc,0 ; Etiquetas de metodo de A

.CODE
A_mc: LOADFP
LOADSP
STOREFP
PUSH 1234
PUSH Object_debugPrint
CALL
PUSH 33
LOAD 3
SWAP
STOREREF 1
LOAD 3
LOADREF 1
PUSH Object_debugPrint
CALL
FMEM 0
STOREFP
RET 1
Constructor_A: 
LOADFP
LOADSP
STOREFP
STOREFP
RET 1

.DATA
VT_Init: NOP 

.CODE
Init_main: LOADFP
LOADSP
STOREFP
RMEM 1
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT_A
STOREREF 0
DUP
PUSH Constructor_A
CALL
STORE 0
LOAD 0
DUP ; Duplico this
LOADREF 0
LOADREF 0
CALL
FMEM 1
STOREFP
RET 0
Constructor_Init: 
LOADFP
LOADSP
STOREFP
STOREFP
RET 1

