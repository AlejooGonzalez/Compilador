.data
VT_Init: NOP ; Clase sin metodos dinamicos

.CODE
const_Init: 
    LOADFP ; Guarda ED
    LOADSP ; Guarda SP
    STOREFP ; Corre FP al SP
    STOREFP ; Usa ED para volver a RA llamador
    RET 1


.CODE
Init_debugPrint: NOP   ; comienzo del método debugPrint
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
STOREFP   ; Restaura FP anterior
RET 1   ; Retorna y limpia parámetros
; Fin del método debugPrint

.CODE
Init_main: NOP   ; comienzo del método main
LOADFP    ; Cargo FP actual
LOADSP    ; Cargo SP actual
STOREFP   ; Actualizo FP para nuevo RA
RMEM 1 ; Reserva memoria para la variable local x
    RMEM 1 ; Reservo puntero
    PUSH 1
    PUSH simple_malloc ; Push direccion de metodo
    CALL
    DUP ; Duplico la referencia al objeto
    PUSH VT_Init ; Etiqueta de la VT
    STOREREF 0 ; Guardo VT en CIR, consumiendo una de las referencias
    DUP ; Duplico this, para metodo de constructor
    PUSH const_B ; Direccion del constructor
    CALL ; Llama al metodo
STORE 0 ; Almacena  el valor de la expresion del tope de la pila en la variable local
FMEM 1   ; Libero memoria variables local
STOREFP   ; Restaura FP anterior
RET 0   ; Retorna y limpia parámetros
; Fin del método main

.data
VT_Object: NOP ; Clase sin metodos dinamicos

.CODE
const_Object: 
    LOADFP ; Guarda ED
    LOADSP ; Guarda SP
    STOREFP ; Corre FP al SP
    STOREFP ; Usa ED para volver a RA llamador
    RET 1


