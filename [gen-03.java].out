.CODE
PUSH Init_main
CALL
HALT

simple_heap_init: RET 0 ; Retorna inmediatamente

simple_malloc: LOADFP    ; Inicialización unidad
LOADSP
STOREFP ; Finaliza inicialización del RA
LOADHL	; hl
DUP	; hl
PUSH 1	; 1
ADD	; hl+1
STORE 4 ; Guarda el resultado (un puntero a la primer celda de la región de memoria)
LOAD 3	; Carga la cantidad de celdas a alojar (parámetro que debe ser positivo)
ADD
STOREHL ; Mueve el heap limit (hl). Expande el heap
STOREFP
RET 1	; Retorna eliminando el parámetro)

Object_debugPrint: LOADFP ; Apila el valor del registro fp
LOADSP
STOREFP
LOAD 3
IPRINT
STOREFP
RET 1

System_read: LOADFP
LOADFP
LOADSP
STOREFP
READ
STORE 3
STOREFP
RET 0

System_printB: LOADFP
LOADSP
STOREFP
LOAD 3 
BPRINT 
STOREFP
RET 1

System_printC: LOADFP
LOADSP
STOREFP
LOAD 3 
CPRINT 
STOREFP
RET 1

System_printI: LOADFP
LOADSP
STOREFP
LOAD 3 
IPRINT 
STOREFP
RET 1

System_printS: LOADFP
LOADSP
STOREFP
LOAD 3 
SPRINT 
STOREFP
RET 1

System_println: LOADFP
LOADSP
STOREFP
PRNLN
STOREFP
RET 0

System_printBln: LOADFP
LOADSP
STOREFP
LOAD 3 
BPRINT 
PRNLN
STOREFP
RET 1

System_printCln: LOADFP
LOADSP
STOREFP
LOAD 3 
CPRINT 
PRNLN
STOREFP
RET 1

System_printIln: LOADFP
LOADSP
STOREFP
LOAD 3 
IPRINT 
PRNLN
STOREFP
RET 1

System_printSln: LOADFP
LOADSP
STOREFP
LOAD 3 
SPRINT 
PRNLN
STOREFP
RET 1

.DATA
VT_A: DW A_m1,A_m2 ; Etiquetas de metodo de A

.CODE
A_m1: LOADFP   ; Apila el valor del registro
LOADSP    ; Apila el valor del registro sp
STOREFP   ; Almacena el tope de la pila en el registro
LOAD 3
LOAD 3
LOADREF 0
LOADREF -1000  ; cargo dirección del método dinámico
CALL                    ; llamada dinámica
FMEM 0
STOREFP   ; Almacena el tope de la pila en el registro
RET 0
A_m2: LOADFP   ; Apila el valor del registro
LOADSP    ; Apila el valor del registro sp
STOREFP   ; Almacena el tope de la pila en el registro
FMEM 0
STOREFP   ; Almacena el tope de la pila en el registro
RET 0
A_debugPrint: LOADFP   ; Apila el valor del registro
LOADSP    ; Apila el valor del registro sp
STOREFP   ; Almacena el tope de la pila en el registro
STOREFP   ; Almacena el tope de la pila en el registro
RET 0
.CODE
Constructor_A: 
LOADFP ; Guarda ED
LOADSP ; Guarda SP
STOREFP ; Corre FP al SP
STOREFP ; Usa ED para volver a RA llamador
RET 1

.DATA
VT_Init: NOP 

.CODE
Init_main: LOADFP   ; Apila el valor del registro
LOADSP    ; Apila el valor del registro sp
STOREFP   ; Almacena el tope de la pila en el registro
RMEM 1 ; Reserva memoria para la variable local x
    RMEM 1 ; Reservo puntero
    PUSH 1
    PUSH simple_malloc ; Push direccion de metodo
    CALL
    DUP ; Duplico la referencia al objeto
    PUSH VT_Init ; Etiqueta de la VT
    STOREREF 0 ; Guardo VT en CIR, consumiendo una de las referencias
    DUP ; Duplico this, para metodo de constructor
    PUSH Constructor_A ; Direccion del constructor
    CALL ; Llama al metodo
STORE -1 ; Almacena  el valor de la expresion del tope de la pila en la variable local
LOAD 3
LOAD 3
LOADREF 0
LOADREF -1000  ; cargo dirección del método dinámico
CALL                    ; llamada dinámica
FMEM 0
STOREFP   ; Almacena el tope de la pila en el registro
RET 0
Init_debugPrint: LOADFP   ; Apila el valor del registro
LOADSP    ; Apila el valor del registro sp
STOREFP   ; Almacena el tope de la pila en el registro
STOREFP   ; Almacena el tope de la pila en el registro
RET 0
.CODE
Constructor_Init: 
LOADFP ; Guarda ED
LOADSP ; Guarda SP
STOREFP ; Corre FP al SP
STOREFP ; Usa ED para volver a RA llamador
RET 1

